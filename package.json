{
  "name": "@rilevera/tree-sitter-sql",
  "version": "1.0.3",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "description": "SQL grammar for tree-sitter, distributed as WebAssembly",
  "license": "MIT",
  "author": "derek stride",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rilevera/tree-sitter-sql.git"
  },
  "main": "./tree-sitter-sql.wasm",
  "types": "./tree-sitter-sql.wasm.d.ts",
  "exports": {
    ".": {
      "types": "./tree-sitter-sql.wasm.d.ts",
      "default": "./tree-sitter-sql.wasm"
    },
    "./tree-sitter-sql.wasm": {
      "types": "./tree-sitter-sql.wasm.d.ts",
      "default": "./tree-sitter-sql.wasm"
    },
    "./highlights.scm": "./queries/highlights.scm"
  },
  "files": [
    "tree-sitter-sql.wasm",
    "tree-sitter-sql.wasm.d.ts",
    "LICENSE",
    "queries/highlights.scm"
  ],
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "sql",
    "webassembly",
    "wasm"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "bun": ">=1.3.6 <1.3.12"
  },
  "scripts": {
    "check:bun": "bun run scripts/check-bun-version.ts",
    "build": "make parser-build",
    "test": "make test"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.26.11"
  }
}
